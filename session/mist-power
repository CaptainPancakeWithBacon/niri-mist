#!/bin/sh
# Power menu in the Mist launcher style. Choosing an entry is the confirmation.
c=$(printf 'Lock\nSuspend\nLog out\nRestart\nShut down\n' | fuzzel --dmenu --lines 5 --width 18)
case "$c" in
  Lock) swaylock -f ;;
  Suspend) systemctl suspend ;;
  "Log out") niri msg action quit --skip-confirmation ;;
  Restart) systemctl reboot ;;
  "Shut down") systemctl poweroff ;;
esac
